.venv/
__pycache__/
*.pyc
.pytest_cache/

# Datasets: regenerable via `make data`; folds.json is the deterministic
# anchor and IS committed
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/folds.json
!data/processed/.gitkeep

# Heavy artifacts: regenerable via `make extract` / `make probe`
artifacts/activations/*
!artifacts/activations/.gitkeep
artifacts/probes/*
!artifacts/probes/.gitkeep

# Figures are regenerated by notebooks and evaluation; CSV summaries stay
docs/figures/*.png

# Notebook outputs: committed notebooks must be executed, but no single
# output may exceed 1 MB (enforced by review, not by git)
logs/*
!logs/.gitkeep

# Canonical result records cited by docs/ensemble_table.md: every
# published number keeps its in-tree source record (same precedent as
# data/processed/folds.json). The rest of logs/ stays regenerable.
!logs/abstention_gpt2.json
!logs/abstention_pythia-410m.json
!logs/abstention_curve_gpt2.json
!logs/abstention_curve_pythia-410m.json
!logs/ensemble_results.json
!logs/ensemble_results_pythia-410m.json
!logs/graph_export_stats.json
!logs/best_config.json
